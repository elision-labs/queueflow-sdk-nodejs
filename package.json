{
  "name": "@queueflow/sdk",
  "version": "1.0.0",
  "description": "Official TypeScript SDK for QueueFlow",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "queueflow",
    "job-queue",
    "distributed-queue",
    "workflow",
    "task-queue"
