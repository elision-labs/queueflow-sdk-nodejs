{
  "name": "queueflow",
  "version": "0.1.0",
  "description": "Alias for @queueflow/sdk - the QueueFlow TypeScript/JavaScript client. Install either name; this package re-exports the real SDK.",
  "license": "MIT",
  "homepage": "https://queueflow.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/elision-labs/queueflow-sdk-nodejs.git",
    "directory": "alias"
  },
  "keywords": ["queue", "jobs", "workflow", "postgres", "queueflow"],
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs"
    }
  },
  "files": ["index.cjs", "index.mjs", "index.d.ts", "README.md"],
  "dependencies": {
    "@queueflow/sdk": "^0.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
